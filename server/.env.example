# Copy this file to .env and change what you need. Every setting is optional.

PORT=8787
OLLAMA_MODEL=gemma3:12b
WHISPER_MODEL=small.en
KOKORO_DIR=T:\kokoro

# The site the monitor tests, and how often.
SITE_URL=https://totallynoob123.github.io/squigglynote/
MONITOR_INTERVAL_HOURS=2

# Your ngrok static domain, if ngrok does not pick it automatically.
# NGROK_DOMAIN=your-name.ngrok-free.dev

# Email alerts for failed test runs. For Gmail, create an app password at
# https://myaccount.google.com/apppasswords (needs 2-step verification) and use it here.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop

# Fixed admin key for the monitor's Recipients tab. If unset, one is generated
# into data\admin-key.txt and printed when the server starts.
# MONITOR_ADMIN_KEY=
